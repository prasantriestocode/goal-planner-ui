// Firestore Security Rules for Goal Planner
//
// DEPLOYMENT INSTRUCTIONS:
// 1. Install Firebase CLI: npm install -g firebase-tools
// 2. Login to Firebase: firebase login
// 3. Deploy rules: firebase deploy --only firestore:rules
// 4. Verify in Firebase Console > Firestore > Rules tab
//
// RULE SUMMARY:
// - Investors: Can read/write only their own plan documents
// - Admin (ops@aarthashastra.com): Can read/write all documents
// - User creation: Only admin can create via Firebase Auth + createInvestor()
// - Self-signup: Only admin email can self-signup
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth.token.email == 'ops@aarthashastra.com';
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ── Users Collection ──────────────────────────────────────────────
    // Stores user role and basic info
    // Structure: { email, role, investorName, createdAt }
    match /users/{userId} {
      // Investors can read their own user doc
      // Admin can read all user docs
      allow read: if isOwner(userId) || isAdmin();

      // Only admin can create user docs (via createInvestor function)
      // Users cannot directly write to their own user doc (prevents role elevation)
      allow create, update, delete: if isAdmin();
    }

    // ── Investor Plans Collection ─────────────────────────────────────
    // Stores all investor plan data: model, goals, goals breakdown, cash flow, etc.
    // Structure: { investorName, model, goals, additionalProperties, ... }
    match /investorPlans/{userId} {
      // Investors can read and write their own plan
      // Admin can read and write all plans (to edit on behalf of investor)
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Deny everything else by default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
